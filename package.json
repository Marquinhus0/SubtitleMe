{
  "name": "subtitleme",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SubtitleMe — Two languages. One experience. Modern dual-subtitle browser extension.",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @subtitleme/chrome-extension dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:browser": "node tests/e2e/chrome-extension.mjs",
    "package:release": "node scripts/package-release.mjs",
    "test:release": "RELEASE_ZIP=dist/release/subtitleme-chrome-v1.0.0.zip node tests/e2e/chrome-extension.mjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "pinia": "^4.1.0",
    "playwright-core": "^1.65.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "vue": "^3.5.46"
  }
}
